---
// full class names so Tailwind can detect them (no string interpolation)
const sizes = {
  '3xl': 'text-3xl',
  '4xl': 'text-3xl md:text-4xl',
  '5xl': 'text-3xl md:text-5xl',
}
const { size = '4xl', as: Tag = 'h2' } = Astro.props
---

<Tag class={`${sizes[size]} border-secondary border-l-4 pl-4 text-balance`}>
  <slot />
</Tag>
