---
import Logo from '../assets/logo.svg'
import ArrowUpRightIcon from '../assets/icons/arrow_up_right.svg'
---

<header>
  <div class="max-w-[96rem] mx-auto px-4 md:px-8 py-6 md:py-8">
    <div class="flex md:items-center justify-between text-white flex-col md:flex-row gap-6">
      <a class="flex flex-row items-center gap-2 group w-fit" href="/">
        <Logo
          width="44"
          height="44"
          class="group-hover:text-primary transition-colors"
          aria-hidden="true"
        />
        <span class="text-3xl" translate="no">
          Mail<span class="font-bold">Fang</span>
        </span>
      </a>

      <nav
        aria-label="Main"
        class="flex flex-row items-center gap-8 md:gap-12 text-lg font-medium"
      >
        <a href="/setup" class="hover:text-primary transition-colors">
          Setup
        </a>
        <a
          href="https://demo.mailfang.com"
          class="hover:text-primary transition-colors flex flex-row gap-1.5 items-center"
          target="_blank"
        >
          Demo
          <ArrowUpRightIcon class="size-4" aria-hidden="true" />
        </a>
        <a
          href="https://github.com/cars10/mailfang"
          class="hover:text-primary transition-colors flex flex-row gap-1.5 items-center"
          target="_blank"
        >
          GitHub <ArrowUpRightIcon class="size-4" aria-hidden="true" />
        </a>
      </nav>
    </div>
  </div>
</header>
