---
import TypewriterReveal from './shared/TypewriterReveal.astro'
import Heading from './shared/Heading.astro'
import ArrowUpRightIcon from '../assets/icons/arrow_up_right.svg'

const demoHost =
  import.meta.env.NODE_ENV === 'development'
    ? 'http://localhost:5173'
    : 'https://demo.mailfang.com'
const demoPath = `${demoHost}/redirect_first_email?reduced=true&demo=true`

const terminalOutput = `$ docker run -p 3000:3000 -p 2525:2525 cars10/mailfang:latest
INFO  [main] Database connected
INFO  [main] Database migrations completed
INFO  [web] Web server listening on 0.0.0.0:3000 
INFO  [smtp] SMTP server listening on 0.0.0.0:2525          
INFO  [main] MailFang is ready!`
---

<div class="max-w-[96rem] mx-auto px-4 md:px-8 mt-6 md:mt-16 grid md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-12 md:gap-16 md:items-center">
  <section class="text-white flex flex-col gap-8">
    <h1 class="text-4xl md:text-5xl leading-tight text-balance">
      Mail<span class="font-bold">Fang</span> is your new{' '}
      <span class="text-secondary">email</span> testing tool.
    </h1>

    <p class="text-xl md:text-2xl font-light leading-relaxed text-gray-300">
      View your emails in a modern web UI, inspect your data in real-time and
      regain control of your infrastructure.
    </p>

    <div class="flex flex-row flex-wrap gap-4">
      <a href="/setup" class="btn btn-secondary">
        Get started
      </a>
      <a
        href="https://github.com/cars10/mailfang"
        class="btn btn-dull"
        target="_blank"
      >
        View on GitHub
      </a>
    </div>
  </section>

  <section aria-label="Live demo">
    <div class="rounded-md overflow-hidden border border-gray-700/70 bg-gray-950 shadow-2xl shadow-black/50">
      <a
        href="https://demo.mailfang.com"
        target="_blank"
        class="group flex items-center gap-3 px-4 h-10 border-b border-gray-800 text-sm text-gray-400 hover:bg-gray-900 hover:text-white transition-colors"
      >
        <span class="flex gap-1.5" aria-hidden="true">
          <span class="size-3 rounded-full bg-gray-700"></span>
          <span class="size-3 rounded-full bg-gray-700"></span>
          <span class="size-3 rounded-full bg-gray-700"></span>
        </span>
        <span
          class="flex-1 flex items-center justify-center gap-1.5 truncate font-mono text-xs"
          translate="no"
        >
          demo.mailfang.com
          <ArrowUpRightIcon
            class="size-3 opacity-0 group-hover:opacity-100 transition-opacity"
            aria-hidden="true"
          />
        </span>
        <span class="flex items-center gap-1.5 text-xs text-secondary font-medium">
          <span
            class="size-2 rounded-full bg-secondary"
            aria-hidden="true"
          ></span>
          Live demo
        </span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
      <iframe
        title="MailFang live demo"
        src={demoPath}
        class="block w-full h-[70svh] md:h-200 bg-black"
        allow="clipboard-write"
      ></iframe>
    </div>
  </section>
</div>

<div class="my-24 md:my-32">
  <section class="max-w-3xl mx-auto px-4 text-white flex flex-col gap-8">
    <Heading size="5xl">
      Why use Mail<span class="font-bold">Fang</span>?
    </Heading>

    <div class="flex flex-col gap-4 text-xl font-light leading-relaxed text-gray-300">
      <p>
        Stop testing emails by sending them to external services (or worse, to
        real users). Mail<span class="font-normal">Fang</span> allows you to
        validate your emails directly on your own infrastructure, keeping your
        data private and your workflow fast.
      </p>
      <p>
        Run it on your hardware to catch bugs and perfect your templates before
        they ever reach an inbox.
      </p>
    </div>

    <TypewriterReveal text={terminalOutput} charDelay={20} />

    <div>
      <a href="/setup" class="btn btn-secondary">
        Get started
      </a>
    </div>
  </section>
</div>
