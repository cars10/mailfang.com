---
import SetupMailfang from '../components/setup/SetupMailfang.astro'
import SendEmails from '../components/setup/SendEmails.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="MailFang - Setup"
  description="Learn how to configure MailFang for your application. Quick setup guide for testing your email delivery without sending real emails."
  keywords="mailfang setup, email testing configuration, smtp setup, mock smtp server"
>
  <div class="max-w-5xl mx-auto px-4 mt-8 md:mt-16 text-white">
    <div class="mb-24">
      <SetupMailfang />
    </div>
    <div class="mb-20">
      <SendEmails />
    </div>

    <div class="mb-20">
      <p class="text-center text-gray-300">
        For more information and available configuration options, please refer
        to the{' '}
        <a
          href="https://github.com/cars10/mailfang?tab=readme-ov-file#configuration"
          class="link"
        >
          GitHub README
        </a>
        .
      </p>
    </div>
  </div>
</Layout>
